# --- PostgreSQL ---
DATABASE_URL=postgresql://user:password@localhost:5432/kenya_agent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Google ---
# Optional: leave blank to use free OpenStreetMap discovery and Google Maps scraping.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_places_api_key

# --- WhatsApp BSP (e.g. Celcom Africa / Wassenger) ---
WHATSAPP_API_URL=https://api.your-bsp.com/v1/messages
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_SENDER_ID=your_business_number

# --- SMS (Africa's Talking) ---
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_key
AT_SENDER_ID=NATHAN_WEB

# --- Email (SendGrid) ---
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=nathan@yourdomain.com
FROM_NAME=Nathan Krop

# --- Portfolio ---
PORTFOLIO_URL=https://nathan-krop-website2.vercel.app/
UTM_SOURCE=agent_outreach

# --- Rate Limits ---
MAX_MESSAGES_PER_NUMBER_PER_DAY=1
MAX_MESSAGES_PER_DAY_GLOBAL=500
MIN_GAP_BETWEEN_SENDS_SECONDS=30
RETRY_BACKOFF_SECONDS=300

# --- Pipeline ---
DISCOVERY_CYCLE_SECONDS=600
RESCAN_INTERVAL_HOURS=24

# --- Proxy (Optional for scale) ---
PROXY_URL=http://user:pass@proxy-host:port

# --- Playwright ---
HEADLESS=true

# --- Dashboard (optional: set a secret key to protect the UI) ---
DASHBOARD_API_KEY=your_secret_dashboard_key
